*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
*.log
.DS_Store

# Compiled Java + COMSOL classpath caches
*.class
compiled/
comsol_support/java/compiled/

# COMSOL model files — generated artifacts, never check in
*.mph
