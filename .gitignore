# Telemetry / linting sidecars produced by mphgen, edit-mph, and check
*.telemetry.jsonl
*.mphgen.json
*.mphedit.json
*.units.json
*.descriptions.json
*.dimensional.json
*.symbols.json
*.slots.jsonl

# Local-run SQLite databases (the data/ dir is tracked via .gitkeep
# but the DB files inside it are generated)
*.db
*.db-journal
*.db-wal
*.db-shm

# Corpus-mining artifacts staged/generated locally (COMSOL-shipped
# model .java exports and derived reports — regenerate per machine
# with `scrape corpus`; see docs/platform-setup.md)
corpus/java/
corpus/java_compiled/
corpus/mph_list.txt
corpus/corpus_statistics.json
corpus/exemplars.json

# Slot harvest dump — regenerated by `comsol-support scrape slots` (~37 MB)
data/slots_dump.jsonl

# Build session artifacts (output dirs created next to a build)
output/
artifacts/
build_workspace*/
mphgen_workspace*/
slot_harvest_workspace*/

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Topic-specific source proposals (kept locally, not version-controlled —
# may reference model-specific debugging work)
docs/proposed_improvements.md

# Build artifacts / tool caches
build/
dist/
.ruff_cache/
